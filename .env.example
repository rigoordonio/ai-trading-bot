# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Database. SQLite for local development; PostgreSQL for docker / production.
DATABASE_URL=sqlite:///data/trading.db
# DATABASE_URL=postgresql+psycopg://trader:CHANGE_ME@localhost:5432/trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trading

# Trading mode. Only "backtest" and "paper" are implemented.
# "live" is deliberately NOT supported; the broker factory refuses it.
TRADING_MODE=paper

# Optional LLM for the explanation layer (explanations only; it never creates orders).
# Provider: none | ollama | anthropic | openai
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which paper broker executes orders:
#   simulated     built-in simulator (default, offline)
#   alpaca_paper  your Alpaca PAPER account (https://paper-api.alpaca.markets only)
BROKER=simulated

# Alpaca PAPER keys (Paper Trading dashboard -> API Keys). Never commit or share these.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# day = market order queued for the next open (default, reliable in paper); opg = opening auction
ALPACA_TIME_IN_FORCE=day

LOG_LEVEL=INFO
